# LLM provider: gemini | anthropic | openai
LLM_PROVIDER=gemini
# Model IDs change often: set them here, nothing is hardcoded in code.
LLM_MODEL=<your-main-model-id>
GUARD_MODEL=<your-small-classifier-model-id>

# Provider keys (only the one for your provider is needed)
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Database (docker-compose maps the container to this host port)
DB_PORT=5439
DATABASE_URL=postgresql://postgres:postgres@localhost:5439/helpdesk
# Read-only role used by the MCP server
MCP_DATABASE_URL=postgresql://helpdesk_ro:helpdesk_ro@localhost:5439/helpdesk

# Retrieval
EMBED_MODEL=BAAI/bge-small-en-v1.5
SIMILARITY_THRESHOLD=0.60
TOP_K=4

# Optional: used only to report estimated cost per question in the eval.
# USD per 1M tokens for LLM_MODEL (check your provider's price page). Leave empty to report tokens only.
PRICE_IN_PER_M=
PRICE_OUT_PER_M=

# Per-request timeout (seconds) for model calls; stalled calls are retried
LLM_TIMEOUT=60
